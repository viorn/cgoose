{
  "name": "rossii",
  "version": "3.2.0",
  "description": "An ACP terminal UI for Goose \u2014 chat, live configuration, session sets",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viorn/rossii.git"
  },
  "homepage": "https://github.com/viorn/rossii#readme",
  "bugs": "https://github.com/viorn/rossii/issues",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "check": "tsc -p tsconfig.json",
    "test": "bun scripts/acp-extensions-test.ts && bun scripts/acp-session-meta-test.ts && bun scripts/acp-session-config-test.ts && bun scripts/sessions-list-test.ts && bun scripts/acp-client-offline-test.ts && bun scripts/acp-overlay-test.ts && bun scripts/acp-thought-test.ts && bun scripts/acp-tool-call-block-test.ts",
    "test:extensions": "bun scripts/acp-extensions-test.ts",
    "test:session-meta": "bun scripts/acp-session-meta-test.ts",
    "test:session-config": "bun scripts/acp-session-config-test.ts",
    "test:sessions": "bun scripts/sessions-list-test.ts",
    "test:client": "bun scripts/acp-client-offline-test.ts",
    "test:overlay": "bun scripts/acp-overlay-test.ts",
    "test:thought": "bun scripts/acp-thought-test.ts",
    "test:tool-call-block": "bun scripts/acp-tool-call-block-test.ts",
    "acp:probe": "bun scripts/acp-probe.ts",
    "acp:smoke": "bun scripts/acp-client-smoke.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@earendil-works/pi-tui": "^1.5.0",
